# Template for .devcontainer/.env, which is gitignored and never committed.
# Copy it before opening the devcontainer:
#
#   cp .devcontainer/.env.example .devcontainer/.env
#
# The values only need to exist, not be meaningful: the repository
# docker-compose.yml guards several variables with ${VAR:?}, and compose
# resolves those when it PARSES the file — before any service-level override
# applies — so the overlay cannot supply them any other way. The mxhook
# service itself never starts in the devcontainer (see runServices).
#
# Placeholders, not secrets. Never reuse these anywhere real.
MXHOOK_WEBHOOK_URL=http://127.0.0.1:9999/unused
MXHOOK_WEBHOOK_SECRET=devcontainer-placeholder
MXHOOK_STATE_ENCRYPTION_KEY=devcontainer-placeholder-key-0000000000
MXHOOK_API_KEY=devcontainer-placeholder
POSTGRES_PASSWORD=mxhook
COMPOSE_PROFILES=postgres
