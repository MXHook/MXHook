# MXHook Configuration
# Copy to .env and adjust values

# SMTP server
MXHOOK_SMTP_ADDR=0.0.0.0:2525
MXHOOK_SMTP_DOMAIN=mail.yourdomain.com

# API server
MXHOOK_API_ADDR=0.0.0.0:8080

# PostgreSQL (required)
MXHOOK_POSTGRES_DSN=postgres://mxhook:mxhook@localhost:5432/mxhook?sslmode=disable

# Cloudflare Queue (optional — omit for local/noop mode)
# CF_QUEUE_ACCOUNT_ID=
# CF_QUEUE_ID=
# CF_QUEUE_TOKEN=
