# Default embedded SQLite deployment
MXHOOK_QUEUE_BACKEND=sqlite
MXHOOK_DATABASE_URL=/data/mxhook.db
MXHOOK_SMTP_ADDR=:2525
MXHOOK_SMTP_DOMAIN=localhost
MXHOOK_SMTP_ALLOWED_DOMAINS=example.com
# Required by the default `all` Compose role on its first start.
MXHOOK_WEBHOOK_URL=
MXHOOK_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 32
MXHOOK_STATE_ENCRYPTION_KEY=
MXHOOK_API_KEY=replace-with-a-long-random-api-key
MXHOOK_API_PORT=8080

# Public SMTP STARTTLS overlay
# Host paths mounted by docker-compose.smtp-tls.yml. The certificate must
# cover the MX hostname (MXHOOK_SMTP_DOMAIN), not the recipient domain.
# Issue with: certbot certonly --standalone -d mx.example.com
# MXHOOK_SMTP_BIND=0.0.0.0
# MXHOOK_SMTP_PORT=25
# MXHOOK_SMTP_CERT_FILE=/etc/letsencrypt/live/mx.example.com/fullchain.pem
# MXHOOK_SMTP_KEY_FILE=/etc/letsencrypt/live/mx.example.com/privkey.pem

# Optional Maildir ingestion. Set MXHOOK_SMTP_ADDR= to disable SMTP.
# MXHOOK_MAILDIR_PATH=/maildir
# MXHOOK_MAILDIR_POLL_INTERVAL=2s
# MXHOOK_MAILDIR_MAX_MESSAGE_BYTES=10485760
# MXHOOK_MAILDIR_RECIPIENT_HEADER=Delivered-To
# MXHOOK_MAILDIR_DEFAULT_RECIPIENT=
# MXHOOK_MAILDIR_ID_NAMESPACE=
# MXHOOK_MAILDIR_ADOPT_EXISTING=false

# Optional Postgres backend
# MXHOOK_QUEUE_BACKEND=postgres
# MXHOOK_DATABASE_URL=postgres://mxhook:mxhook@postgres:5432/mxhook?sslmode=disable

# Optional Cloudflare Queue backend
# MXHOOK_QUEUE_BACKEND=cloudflare
# CF_QUEUE_ACCOUNT_ID=
# CF_QUEUE_ID=
# CF_QUEUE_TOKEN=
