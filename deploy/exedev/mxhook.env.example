MXHOOK_RUNTIME_ROLE=worker
MXHOOK_QUEUE_BACKEND=sqlite
MXHOOK_DATABASE_URL=/var/lib/mxhook/mxhook.db
MXHOOK_STORAGE_RAW_DIR=/var/lib/mxhook/raw

MXHOOK_SMTP_ADDR=
MXHOOK_MAILDIR_PATH=
MXHOOK_MAILDIR_POLL_INTERVAL=2s
MXHOOK_MAILDIR_MAX_MESSAGE_BYTES=1048576
MXHOOK_MAILDIR_RECIPIENT_HEADER=Delivered-To
MXHOOK_MAILDIR_ID_NAMESPACE=exe.dev:mxhook

MXHOOK_API_ADDR=127.0.0.1:8080
MXHOOK_API_KEY=replace-with-random-secret
MXHOOK_STATE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
MXHOOK_RUNTIME_SHUTDOWN_GRACE_PERIOD=30s

# Optional static catch-all route. Alternatively create a durable API route,
# then switch MXHOOK_RUNTIME_ROLE=all and set the Maildir path above.
# MXHOOK_WEBHOOK_URL=https://receiver.example.com/email
# MXHOOK_WEBHOOK_SECRET=replace-with-random-secret
